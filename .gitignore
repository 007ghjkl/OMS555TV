# 构建产物
/build/
/build-*/
**/build/
/out/
/cmake-build-*/
/tmp/

# Qt Creator / IDE 本地状态
*.user
*.user.*
.vs/
.vscode/
.idea/

# STM32Cube / STM32 VS Code 本地生成状态
/firmware/stm32/.clangd
/firmware/stm32/.gitignore
/firmware/stm32/.settings/
/firmware/stm32/.settings/**
/firmware/stm32/mx.scratch

# 编译器与调试产物
*.obj
*.o
*.exe
*.dll
*.pdb
*.ilk

# 运行输出（保留目录说明文件）
/output/logs/*
!/output/logs/.gitkeep
/output/reports/*
!/output/reports/.gitkeep

# 操作系统文件
Thumbs.db
Desktop.ini
.DS_Store
