        { "id": "recovery", "type": "observe_recovery", "probe": { "function": 3, "address": 16, "count": 1 }, "interval_ms": 500, "deadline_ms": 10000, "consecutive_matches": 3, "business_assertion": { "type": "range", "min": 0, "max": 65535 } }
