{
  "schema_version": 2,
  "id": "phase6-schema-v2-example",
  "name": "Phase 6 Schema v2 中文示例",
  "description": "只用于展示和 Loader 验证，不计入正式测试套件。",
  "tags": ["phase6", "example"],
  "metadata": {"purpose": "schema-v2-example"},
  "cases": [
    {
      "id": "example-elements",
      "name": "四路温度逐元素范围",
      "category": "数据一致性",
      "environment": "both",
      "type": "read_registers",
      "request": {"function": 3, "address": 0, "count": 4},
      "expected": {
        "type": "elements",
        "items": [
          {"index": 0, "type": "range", "min": -400, "max": 1250, "representation": "int16", "decimal_places": 1, "unit": "℃"},
          {"index": 1, "type": "range", "min": -400, "max": 1250, "representation": "int16", "decimal_places": 1, "unit": "℃"},
          {"index": 2, "type": "range", "min": -400, "max": 1250, "representation": "int16", "decimal_places": 1, "unit": "℃"},
          {"index": 3, "type": "range", "min": -400, "max": 1250, "representation": "int16", "decimal_places": 1, "unit": "℃"}
        ]
      }
    },
    {
      "id": "example-sequence",
      "name": "协议异常后合法读取",
      "category": "自动恢复",
      "environment": "fake",
      "type": "sequence",
      "repeat_count": 2,
      "failure_policy": "continue_on_failure",
      "timeout": {"request_ms": 500, "case_ms": 10000},
      "steps": [
        {
          "id": "timeout",
          "type": "expect_timeout",
          "delay_before_ms": 0,
          "request": {"function": 3, "address": 0, "count": 1},
          "expected": {"type": "response_timeout", "source": "deterministic_no_response"},
          "fault": "no_response"
        },
        {
          "id": "recovered-read",
          "type": "read_register",
          "delay_before_ms": 10,
          "request": {"function": 3, "address": 39, "count": 1},
          "expected": {"type": "equals", "value": 0}
        }
      ]
    },
    {
      "id": "example-timeout",
      "name": "确定性响应超时",
      "category": "协议",
      "environment": "fake",
      "type": "expect_timeout",
      "request": {"function": 3, "address": 0, "count": 1},
      "expected": {"type": "response_timeout", "source": "deterministic_no_response"},
      "timeout": {"request_ms": 100, "case_ms": 100},
      "fault": "no_response"
    },
    {
      "id": "example-uptime",
      "name": "运行时间低高字非递减",
      "category": "数据一致性",
      "environment": "both",
      "type": "consistency",
      "request": {"function": 3, "address": 30, "count": 2},
      "expected": {"type": "uint32", "word_order": "low_word_first", "comparison": "non_decreasing", "min": 0, "max": 4294967295, "unit": "s"},
      "timeout": {"request_ms": 500, "case_ms": 1100},
      "consistency": {"sample_count": 2, "interval_ms": 100}
    },
    {
      "id": "example-stability",
      "name": "十分钟连续轮询配置",
      "category": "稳定性",
      "environment": "real_rs485",
      "type": "stability",
      "request": {"function": 3, "address": 0, "count": 5},
      "expected": {
        "type": "stability_summary",
        "min_total": 594,
        "min_successes": 594,
        "max_failures": 6,
        "max_timeouts": 6,
        "max_failure_rate_ppm": 10000,
        "rtt_ms": {"require_valid_samples": true, "minimum_sample": 0, "maximum_average": 500, "maximum_sample": 1000}
      },
      "timeout": {"request_ms": 500, "case_ms": 600500},
      "stability": {"duration_ms": 600000, "interval_ms": 1000, "minimum_successes": 594, "allowed_failure_rate_ppm": 10000}
    }
  ]
}
