{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oms555tv.local/schema/test-suite-v1.schema.json",
  "title": "OMS555TV 测试套件 v1",
  "description": "TASK-014 测试套件结构契约；跨字段规则同时由 x-oms555tv-semantic-constraints 与 TestCaseLoader 校验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/name" },
    "description": { "$ref": "#/$defs/description" },
    "tags": { "$ref": "#/$defs/tags" },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
      "additionalProperties": { "type": "string", "maxLength": 256 }
    },
    "cases": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/testCase" }
    }
  },
  "x-oms555tv-semantic-constraints": [
    "所有字符串按 trim 后校验长度，case.id 在套件内唯一",
    "address + count - 1 必须小于等于 65535",
    "range.min 必须小于等于 range.max",
    "register_sequence.values 长度必须等于 request.count",
    "bitmask.value 不得包含 mask 外的位",
    "写用例 equals.value 必须等于 request.value",
    "write_and_verify 的 restore_original=true 要求 read_before_write=true",
    "timeout.case_ms 必须大于等于 timeout.request_ms"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?:\\S|\\S.*\\S)$" },
    "description": { "type": "string", "maxLength": 1024 },
    "category": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?:\\S|\\S.*\\S)$" },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^(?:\\S|\\S.*\\S)$" }
    },
    "unit": { "type": "string", "maxLength": 16 },
    "representation": {
      "type": "string",
      "enum": ["uint16", "int16"],
      "default": "uint16"
    },
    "timeout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_ms"],
      "properties": {
        "request_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "case_ms": { "type": "integer", "minimum": 1, "maximum": 300000 }
      }
    },
    "compoundTimeout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_ms", "case_ms"],
      "properties": {
        "request_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "case_ms": { "type": "integer", "minimum": 1, "maximum": 300000 }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries", "on_errors"],
      "properties": {
        "max_retries": { "type": "integer", "minimum": 1, "maximum": 3 },
        "on_errors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["timeout", "connection", "serial", "crc", "protocol"]
          }
        }
      }
    },
    "commonCase": {
      "type": "object",
      "required": ["id", "name", "category", "type", "request", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "category": { "$ref": "#/$defs/category" },
        "description": { "$ref": "#/$defs/description" },
        "type": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "tags": { "$ref": "#/$defs/tags" },
        "request": { "type": "object" },
        "expected": { "type": "object" },
        "timeout": { "type": "object" },
        "retry": { "$ref": "#/$defs/retry" }
      }
    },
    "readRequestOne": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "address", "count"],
      "properties": {
        "function": { "const": 3 },
        "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "count": { "const": 1 }
      }
    },
    "readRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "address", "count"],
      "properties": {
        "function": { "const": 3 },
        "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "count": { "type": "integer", "minimum": 1, "maximum": 125 }
      }
    },
    "writeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "address", "value"],
      "properties": {
        "function": { "const": 6 },
        "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "value": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "writeAndVerifyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "verify_function", "address", "value", "read_before_write", "restore_original"],
      "properties": {
        "function": { "const": 6 },
        "verify_function": { "const": 3 },
        "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "value": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "read_before_write": { "type": "boolean" },
        "restore_original": { "type": "boolean" }
      }
    },
    "exceptionRequest": {
      "oneOf": [
        { "$ref": "#/$defs/readRequest" },
        { "$ref": "#/$defs/writeRequest" }
      ]
    },
    "equalsAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "equals" },
        "value": { "type": "integer", "minimum": -32768, "maximum": 65535 },
        "representation": { "$ref": "#/$defs/representation" },
        "unit": { "$ref": "#/$defs/unit" }
      },
      "allOf": [
        {
          "if": {
            "required": ["representation"],
            "properties": { "representation": { "const": "int16" } }
          },
          "then": { "properties": { "value": { "maximum": 32767 } } },
          "else": { "properties": { "value": { "minimum": 0 } } }
        }
      ]
    },
    "rangeAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "min", "max"],
      "properties": {
        "type": { "const": "range" },
        "min": { "type": "integer", "minimum": -32768, "maximum": 65535 },
        "max": { "type": "integer", "minimum": -32768, "maximum": 65535 },
        "representation": { "$ref": "#/$defs/representation" },
        "unit": { "$ref": "#/$defs/unit" }
      },
      "allOf": [
        {
          "if": {
            "required": ["representation"],
            "properties": { "representation": { "const": "int16" } }
          },
          "then": {
            "properties": {
              "min": { "maximum": 32767 },
              "max": { "maximum": 32767 }
            }
          },
          "else": {
            "properties": {
              "min": { "minimum": 0 },
              "max": { "minimum": 0 }
            }
          }
        }
      ]
    },
    "sequenceAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": { "const": "register_sequence" },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 125,
          "items": { "type": "integer", "minimum": -32768, "maximum": 65535 }
        },
        "representation": { "$ref": "#/$defs/representation" },
        "unit": { "$ref": "#/$defs/unit" }
      },
      "allOf": [
        {
          "if": {
            "required": ["representation"],
            "properties": { "representation": { "const": "int16" } }
          },
          "then": {
            "properties": {
              "values": { "items": { "maximum": 32767 } }
            }
          },
          "else": {
            "properties": {
              "values": { "items": { "minimum": 0 } }
            }
          }
        }
      ]
    },
    "sequenceOneAssertion": {
      "allOf": [
        { "$ref": "#/$defs/sequenceAssertion" },
        { "properties": { "values": { "minItems": 1, "maxItems": 1 } } }
      ]
    },
    "bitmaskAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mask", "value"],
      "properties": {
        "type": { "const": "bitmask" },
        "mask": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "value": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "exceptionAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code"],
      "properties": {
        "type": { "const": "modbus_exception" },
        "code": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "singleRegisterAssertion": {
      "oneOf": [
        { "$ref": "#/$defs/equalsAssertion" },
        { "$ref": "#/$defs/rangeAssertion" },
        { "$ref": "#/$defs/sequenceOneAssertion" },
        { "$ref": "#/$defs/bitmaskAssertion" }
      ]
    },
    "readRegistersAssertion": {
      "oneOf": [
        { "$ref": "#/$defs/equalsAssertion" },
        { "$ref": "#/$defs/rangeAssertion" },
        { "$ref": "#/$defs/sequenceAssertion" },
        { "$ref": "#/$defs/bitmaskAssertion" }
      ]
    },
    "testCase": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/commonCase" },
            {
              "properties": {
                "type": { "const": "read_register" },
                "request": { "$ref": "#/$defs/readRequestOne" },
                "expected": { "$ref": "#/$defs/singleRegisterAssertion" },
                "timeout": { "$ref": "#/$defs/timeout" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonCase" },
            {
              "properties": {
                "type": { "const": "read_registers" },
                "request": { "$ref": "#/$defs/readRequest" },
                "expected": { "$ref": "#/$defs/readRegistersAssertion" },
                "timeout": { "$ref": "#/$defs/timeout" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonCase" },
            {
              "properties": {
                "type": { "const": "write_register" },
                "request": { "$ref": "#/$defs/writeRequest" },
                "expected": { "$ref": "#/$defs/equalsAssertion" },
                "timeout": { "$ref": "#/$defs/timeout" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonCase" },
            {
              "required": ["timeout"],
              "properties": {
                "type": { "const": "write_and_verify" },
                "request": { "$ref": "#/$defs/writeAndVerifyRequest" },
                "expected": { "$ref": "#/$defs/equalsAssertion" },
                "timeout": { "$ref": "#/$defs/compoundTimeout" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonCase" },
            {
              "properties": {
                "type": { "const": "expect_exception" },
                "request": { "$ref": "#/$defs/exceptionRequest" },
                "expected": { "$ref": "#/$defs/exceptionAssertion" },
                "timeout": { "$ref": "#/$defs/timeout" }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
