{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oms555tv.local/schema/test-suite-v3.schema.json",
  "title": "OMS555TV Host Phase 7 引导式测试套件 v3",
  "description": "TASK-021 引导式恢复输入契约；跨字段预算、顺序及安全规则同时由 TestCaseLoader 校验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "cases"],
  "properties": {
    "schema_version": { "const": 3 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/name" },
    "description": { "$ref": "#/$defs/description" },
    "tags": { "$ref": "#/$defs/tags" },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
      "additionalProperties": { "type": "string", "maxLength": 256 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/guidedRecoveryCase" }
    }
  },
  "x-oms555tv-semantic-constraints": [
    "v3 是独立引导式套件；v1/v2 自动套件继续由各自版本加载，不改变其语义",
    "guided_recovery 固定为断线提示、中断观察、重连提示、恢复观察四步，step.id 在用例内唯一",
    "人工提示必须同时允许 confirm 与 cancel，且必须提供取消后的恢复接线指引",
    "用户确认只声明动作完成，不能单独构成中断或恢复 PASS 证据",
    "中断仅由连续 ResponseTimeout 命中；取消、权限错误、端口消失和其他通信错误不得计为命中",
    "恢复仅由合法 0x03 响应命中；配置业务断言时还必须同时满足断言",
    "探测只允许功能码 0x03，禁止写请求、脚本、Shell 和任意可执行动作",
    "case_ms 必须覆盖两次人工等待上限与两次观察 deadline 的总和",
    "UTC 只用于审计；等待、deadline、连续命中和恢复耗时使用单调时钟"
  ],
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^(?:\\S|\\S.*\\S)$"
    },
    "description": { "type": "string", "maxLength": 1024 },
    "category": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^(?:\\S|\\S.*\\S)$"
    },
    "tags": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 1, "maxLength": 32,
        "pattern": "^(?:\\S|\\S.*\\S)$"
      }
    },
    "timeout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_ms", "case_ms"],
      "properties": {
        "request_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "case_ms": { "type": "integer", "minimum": 1, "maximum": 900000 }
      }
    },
    "readProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "address", "count"],
      "properties": {
        "function": { "const": 3 },
        "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "count": { "type": "integer", "minimum": 1, "maximum": 125 }
      }
    },
    "scalarBusinessAssertion": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "equals" },
            "value": { "type": "integer", "minimum": -32768, "maximum": 65535 },
            "representation": { "enum": ["uint16", "int16"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "min", "max"],
          "properties": {
            "type": { "const": "range" },
            "min": { "type": "integer", "minimum": -32768, "maximum": 65535 },
            "max": { "type": "integer", "minimum": -32768, "maximum": 65535 },
            "representation": { "enum": ["uint16", "int16"] }
          }
        }
      ]
    },
    "disconnectPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "purpose", "title", "instruction", "safety_notice", "allowed_actions", "wait_timeout_ms", "cancel_recovery_instruction"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "operator_prompt" },
        "purpose": { "const": "disconnect_rs485" },
        "title": { "$ref": "#/$defs/name" },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "safety_notice": { "type": "string", "minLength": 1, "maxLength": 512 },
        "allowed_actions": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["confirm", "cancel"] },
          "allOf": [
            { "contains": { "const": "confirm" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "const": "cancel" }, "minContains": 1, "maxContains": 1 }
          ]
        },
        "wait_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "cancel_recovery_instruction": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "reconnectPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "purpose", "title", "instruction", "safety_notice", "allowed_actions", "wait_timeout_ms", "cancel_recovery_instruction"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "operator_prompt" },
        "purpose": { "const": "reconnect_rs485" },
        "title": { "$ref": "#/$defs/name" },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "safety_notice": { "type": "string", "minLength": 1, "maxLength": 512 },
        "allowed_actions": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["confirm", "cancel"] },
          "allOf": [
            { "contains": { "const": "confirm" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "const": "cancel" }, "minContains": 1, "maxContains": 1 }
          ]
        },
        "wait_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "cancel_recovery_instruction": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "outageObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "probe", "interval_ms", "deadline_ms", "consecutive_matches"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "observe_outage" },
        "probe": { "$ref": "#/$defs/readProbe" },
        "interval_ms": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "deadline_ms": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "consecutive_matches": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "recoveryObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "probe", "interval_ms", "deadline_ms", "consecutive_matches"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "observe_recovery" },
        "probe": { "$ref": "#/$defs/readProbe" },
        "interval_ms": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "deadline_ms": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "consecutive_matches": { "type": "integer", "minimum": 1, "maximum": 20 },
        "business_assertion": { "$ref": "#/$defs/scalarBusinessAssertion" }
      }
    },
    "guidedRecoveryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "environment", "type", "timeout", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "category": { "$ref": "#/$defs/category" },
        "description": { "$ref": "#/$defs/description" },
        "environment": { "enum": ["real_rs485", "fake"] },
        "type": { "const": "guided_recovery" },
        "enabled": { "type": "boolean", "default": true },
        "tags": { "$ref": "#/$defs/tags" },
        "timeout": { "$ref": "#/$defs/timeout" },
        "steps": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "$ref": "#/$defs/disconnectPrompt" },
            { "$ref": "#/$defs/outageObservation" },
            { "$ref": "#/$defs/reconnectPrompt" },
            { "$ref": "#/$defs/recoveryObservation" }
          ],
          "items": false
        }
      }
    }
  }
}
